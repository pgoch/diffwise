{
  "name": "diffwise",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve demo",
    "build": "ng build ngx-diffwise && node -e \"require('fs').copyFileSync('LICENSE', 'dist/ngx-diffwise/LICENSE')\"",
    "build:demo": "ng build demo",
    "watch": "ng build ngx-diffwise --watch --configuration development",
    "test": "npm run test:engine && npm run test:angular",
    "test:engine": "vitest run",
    "test:angular": "ng test ngx-diffwise --watch=false",
    "lint": "ng lint",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "dompurify": "^3.4.17",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.42",
    "@angular/cli": "^20.3.42",
    "@angular/compiler-cli": "^20.3.0",
    "angular-eslint": "20.7.0",
    "eslint": "^9.39.1",
    "jsdom": "^27.4.0",
    "ng-packagr": "^20.3.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.46.4",
    "vitest": "^3.2.7"
  },
  "description": "Side-by-side diffs of rendered HTML for Angular"
}
